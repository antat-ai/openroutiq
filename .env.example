# OpenRoutiQ itself makes no provider calls unless you use a provider client or the proxy.
# Copy only the variables you need into a local .env file; .env files are git-ignored.

# Required before binding the optional proxy to a non-loopback address.
OPENROUTIQ_PROXY_API_KEY=replace-with-a-long-random-bearer-token

# Provider credentials used by your SDK client or LiteLLM.
OPENAI_API_KEY=replace-me
ANTHROPIC_API_KEY=replace-me
OPENROUTER_API_KEY=replace-me
REQUESTY_API_KEY=replace-me
NOTDIAMOND_API_KEY=replace-me
